---
import Base from '../layouts/Base.astro';
import RackScene from '../scene/RackScene';
import { resume, fmtMonth, certStatus } from '../data/resume';

const certs = resume.certifications.map((c) => ({ ...c, ...certStatus(c) }))
  .sort((a, b) => Number(b.active) - Number(a.active) || String(b.issued).localeCompare(String(a.issued)));
const year = (ym: string) => (ym === 'present' ? 'now' : String(ym).slice(0, 4));
---
<Base>
  <a class="skip" href="#main">Skip to the resume</a>
  <div class="page">
    <div class="stage-col">
      <RackScene client:only="react" />
    </div>

    <main id="main" class="content">
      <section class="unit" data-rack="screen" aria-labelledby="name">
        <div class="head"><span class="u">U1–U2, the display</span></div>
        <h1 class="name" id="name">{resume.name}</h1>
        <p class="role">{resume.title}, {resume.location}</p>
        <p class="pitch">{resume.summary}</p>
        <div class="links">
          <a class="btn primary" href={`mailto:${resume.email}`}>Email me</a>
          <a class="btn" href="/resume.pdf">Resume (PDF)</a>
          <a class="btn" href={resume.links.linkedin} rel="me">LinkedIn</a>
          <a class="btn" href={resume.links.github} rel="me">GitHub</a>
        </div>
      </section>

      <section class="unit" data-rack="switch" aria-labelledby="exp-h">
        <div class="head">
          <span class="u">U3, the switch</span>
          <h2 id="exp-h">Experience</h2>
        </div>
        {resume.experience.map((j) => (
          <article class="job">
            <div class="when">{year(j.start)}–{year(j.end)}</div>
            <div>
              <h3>{j.company}</h3>
              <p class="title">{j.role}{j.note && `, ${j.note.toLowerCase().replace('intern', 'from intern')}`}</p>
              <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
            </div>
          </article>
        ))}
      </section>

      <section class="unit" data-rack="pis" aria-labelledby="proj-h">
        <div class="head">
          <span class="u">U4–U5, four Raspberry Pi 5s</span>
          <h2 id="proj-h">Projects</h2>
        </div>
        {resume.projects.map((p) => (
          <article class="project">
            <h3>
              {p.link ? <a href={p.link}>{p.name}</a> : p.name}
              {p.status && <span class="status">{p.status}</span>}
            </h3>
            <p>{p.blurb}</p>
            <p class="built">Built with {p.tags.slice(0, -1).join(', ')} and {p.tags.at(-1)}.</p>
          </article>
        ))}
      </section>

      <section class="unit" data-rack="blank" aria-labelledby="skills-h">
        <div class="head">
          <span class="u">U6–U8, room to grow</span>
          <h2 id="skills-h">Skills and certifications</h2>
        </div>
        <dl class="skills">
          {Object.entries(resume.skills).map(([group, items]) => (
            <>
              <dt>{group}</dt>
              <dd>{items.join(', ')}</dd>
            </>
          ))}
        </dl>

        <h3 class="sub">Certifications</h3>
        <table class="certs">
          <tbody>
            {certs.map((c) => (
              <tr>
                <td>{c.name}<br /><span class="state">{c.issuer}</span></td>
                <td class={`state ${c.active ? 'valid' : ''}`}>{c.label}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <h3 class="sub">Education</h3>
        <ul class="edu">
          {resume.education.map((e) => <li>{e.degree}, {e.school}, {e.years}</li>)}
        </ul>

        <div class="links" style="margin-top:48px">
          <a class="btn primary" href={`mailto:${resume.email}`}>Email me</a>
          <a class="btn" href="/resume.pdf">Resume (PDF)</a>
        </div>
        <p class="foot">
          This site runs on the rack beside it: four Raspberry Pis running Kubernetes, deployed with Flux.
          The lights and the face on the screen show the cluster live. See <a href="/how-it-works">how this site works</a>, or the <a href="https://github.com/0xJMart/resume-site">source on GitHub</a>.
        </p>
      </section>
    </main>
  </div>
</Base>
